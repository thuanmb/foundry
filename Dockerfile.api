# Multi-module Dockerfile for api-server
# Build context: project root
# Requires BuildKit: DOCKER_BUILDKIT=1 docker build ...

# Stage 1: Build common + api-server
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app

COPY pom.xml .
COPY common/pom.xml common/
COPY api-server/pom.xml api-server/
COPY worker/pom.xml worker/

RUN --mount=type=cache,target=/root/.m2 \
    mvn dependency:go-offline -pl common,api-server

COPY common/src common/src/
COPY api-server/src api-server/src/

RUN --mount=type=cache,target=/root/.m2 \
    mvn clean package -pl common,api-server -DskipTests

# Stage 2: Runtime
FROM eclipse-temurin:21-jdk

RUN mkdir -p /etc/opt/foundry/config

WORKDIR /app

COPY --from=build /app/api-server/target/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
