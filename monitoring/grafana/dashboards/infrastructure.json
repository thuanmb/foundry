{
  "uid": "foundry-infrastructure",
  "title": "Foundry — Infrastructure",
  "tags": ["foundry", "infrastructure"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "templating": {
    "list": [
      { "name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "label": "Prometheus" }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage (per pod)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [ { "expr": "sum(rate(process_cpu_usage[5m])) by (instance)", "legendFormat": "{{instance}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "JVM heap used (per pod)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [ { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (instance)", "legendFormat": "{{instance}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "DB connections (per pod)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [ { "expr": "sum(hikaricp_connections_active) by (instance)", "legendFormat": "{{instance}}", "refId": "A" } ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pod restarts (1h)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [ { "expr": "increase(kube_pod_container_status_restarts_total[1h])", "legendFormat": "{{pod}}", "refId": "A" } ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "JVM non-heap memory used",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [ { "expr": "sum(jvm_memory_used_bytes{area=\"nonheap\"}) by (instance)", "legendFormat": "{{instance}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Garbage collection time",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [ { "expr": "sum(rate(jvm_gc_pause_seconds_sum[5m])) by (instance)", "legendFormat": "{{instance}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
