# =============================================================================
# Foundry — Local Development Environment Variables
# =============================================================================
# Copy this file to .env and fill in values:
#   cp .env.example .env
# The Makefile loads .env automatically. Never commit .env.
# =============================================================================

# --- Database (used by docker-compose, Spring Boot and Helm installs) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/foundry
SPRING_DATASOURCE_USERNAME=foundry_app
SPRING_DATASOURCE_PASSWORD=foundry_local_pass
DB_NAME=foundry
DB_HOST=foundry-postgresql

# --- JWE (anonymous token encryption) ---
# Generate: openssl rand -base64 32
AUTH_JWE_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# --- JWT (authenticated token signing) ---
# Generate: openssl rand -base64 64
AUTH_JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_64

# --- Cloudflare Turnstile (web bot protection) ---
# Test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Device attestation (mobile anonymous tokens) ---
IOS_APP_ID=TEAMID.com.thuanbui.foundry
IOS_ATTEST_ENVIRONMENT=development
ANDROID_PACKAGE_NAME=com.thuanbui.foundry
PLAY_INTEGRITY_DECRYPTION_KEY=
PLAY_INTEGRITY_VERIFICATION_KEY=
# true for local dev (simulators/emulators can't attest)
ATTESTATION_BYPASS_ENABLED=true

# --- SMS OTP. SMS_PROVIDER=noop logs OTPs (dev only); set twilio + credentials for real SMS ---
SMS_PROVIDER=noop
# TWILIO_ACCOUNT_SID=AC_CHANGE_ME
# TWILIO_AUTH_TOKEN=CHANGE_ME
# TWILIO_FROM_NUMBER=+1234567890

# --- Firebase (verifies client-side phone-auth ID tokens) ---
FIREBASE_WEB_API_KEY=CHANGE_ME

# --- Worker LLM (optional; only used when ECHO_LLM_ENABLED=true) ---
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ECHO_LLM_ENABLED=false
